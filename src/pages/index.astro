---
import "../styles/global.css";
import "../styles/scale-themes.css";
import { BARS } from "../lib/composition.ts";
import { BLOCKS } from "../lib/editorGrid.ts";

const BARS_PER_BLOCK = BARS / BLOCKS;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>One Melody, Many Worlds</title>
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
    </header>
    <main>
      <div class="intro">
        <h1>One Melody, Many Worlds</h1>
        <p>
          Pick a scale. The melody stays the same — same notes, same rhythm,
          same starting pitch — only the scale each note is drawn from
          changes. A scale is one ingredient of a musical tradition, not the
          whole thing: this isn't "this melody, but Chinese/Japanese/Arabic,"
          it's the same tune reinterpreted through a different set of
          intervals.
        </p>
      </div>

      <div class="theme-scope world" data-scale-theme="major" data-testid="theme-scope">
        <div class="world-inner">
          <section class="panel" aria-label="Presets">
            <h2>Presets</h2>
            <div class="preset-tracks">
              <button type="button" class="track-button" data-testid="editor-preset-twinkle">
                Twinkle Twinkle Little Star
              </button>
              <button type="button" class="track-button" data-testid="editor-preset-joy">Joy to the World</button>
              <button type="button" class="track-button" data-testid="editor-preset-moli-hua">
                Mo Li Hua / 茉莉花
              </button>
              <button type="button" class="track-button track-button--clear" data-testid="editor-clear-button">
                Clear / New Composition
              </button>
            </div>
          </section>

          <section class="panel" aria-label="Style controls">
            <h2>Style</h2>
            <form class="style-form">
              <div class="style-field">
                <label for="source-scale">Style</label>
                <select id="source-scale" data-testid="editor-source-select" name="source-scale">
                  <option value="Major">Major</option>
                  <option value="Natural Minor">Natural Minor</option>
                  <option value="Harmonic Minor">Harmonic Minor</option>
                  <option value="Melodic Minor (ascending)">Melodic Minor (ascending)</option>
                  <option value="Dorian">Dorian</option>
                  <option value="Phrygian">Phrygian</option>
                  <option value="Hijaz">Hijaz</option>
                  <option value="Major Pentatonic">Major Pentatonic (experimental)</option>
                  <option value="In Sen">In Sen (experimental)</option>
                </select>
              </div>

              <span class="style-connector" aria-hidden="true">→</span>

              <div class="style-field">
                <label for="target-scale">Target style</label>
                <select id="target-scale" data-testid="editor-target-select" name="target-scale">
                  <option value="Major">Major</option>
                  <option value="Natural Minor">Natural Minor</option>
                  <option value="Harmonic Minor">Harmonic Minor</option>
                  <option value="Melodic Minor (ascending)">Melodic Minor (ascending)</option>
                  <option value="Dorian">Dorian</option>
                  <option value="Phrygian">Phrygian</option>
                  <option value="Hijaz">Hijaz</option>
                  <option value="Major Pentatonic">Major Pentatonic (experimental)</option>
                  <option value="In Sen">In Sen (experimental)</option>
                </select>
              </div>
            </form>
            <p class="hint">Changing style clears your composition.</p>
            <p class="hint">
              When target style differs from style, a second row group below shows where your notes move; Play
              plays the transformed result.
            </p>
          </section>

          <section class="panel" aria-label="Playback">
            <h2>Playback</h2>
            <div class="transport">
              <button type="button" class="transport-button transport-button--play" data-testid="editor-play-button"
                >Play</button
              >
              <button type="button" class="transport-button transport-button--stop" data-testid="editor-stop-button"
                >Stop</button
              >
            </div>
          </section>

          <section class="panel" aria-label="Waveform">
            <h2>Waveform</h2>
            <p id="waveform-description">
              A live view of the audio signal while it plays; calm and flat when nothing is sounding.
            </p>
            <div class="waveform-panel">
              <canvas
                data-testid="editor-waveform"
                role="img"
                aria-label="Live audio waveform"
                aria-describedby="waveform-description"
              ></canvas>
            </div>
          </section>

          <section class="panel" aria-label="Keyboard">
            <h2>Keyboard</h2>
            <div class="piano-scroll">
              <div
                class="piano"
                data-testid="editor-keyboard"
                role="img"
                aria-label="Piano keyboard showing currently sounding notes"
              >
              </div>
            </div>
          </section>

          <section class="panel" aria-label="Composition editor">
            <h2>Composition editor</h2>
            <p>
              Click or drag across a row to place a note; click a note to remove
              it. Arrow keys move focus, Enter/Space places or removes a note, and
              Shift + Arrow resizes one.
            </p>

            <p>
              Transformed notes:
              <output data-testid="editor-transformed-notes"></output>
            </p>

            <div class="blocks">
              {
                Array.from({ length: BLOCKS }, (_, blockIndex) => (
                  <section class="editor-block">
                    <h3>
                      Bars {blockIndex * BARS_PER_BLOCK + 1}–{blockIndex * BARS_PER_BLOCK + BARS_PER_BLOCK}
                    </h3>
                    <div class="grid-scroll">
                      <div data-testid={`composition-grid-block-${blockIndex}`} />
                    </div>
                  </section>
                ))
              }
            </div>
          </section>
        </div>
      </div>
    </main>

    <script>
      import {
        BARS,
        type Composition,
        createEmptyComposition,
        pitchRowsForComposition,
        renderComposition,
        sequentialToComposition,
        STEPS_PER_BAR,
        STEPS_PER_BEAT,
        transformCompositionToTarget,
      } from "../lib/composition.ts";
      import {
        BLOCKS,
        clampDragEnd,
        commitDrag,
        noteAt,
        pitchLabel,
        removeNoteAt,
        resizeNote,
        stepForBlockColumn,
        STEPS_PER_BLOCK,
      } from "../lib/editorGrid.ts";
      import { BEAT_SECONDS, getAnalyser, playerEvents, playEvents, stop } from "../lib/audio.ts";
      import { JOY_TO_THE_WORLD, MO_LI_HUA, type Melody, TWINKLE_TWINKLE } from "../lib/melodies.ts";
      import { keyboardKeys, withVoiceEnded, withVoiceStarted, type VoiceCounts } from "../lib/keyboard.ts";
      import { idlePoints, waveformPoints } from "../lib/waveform.ts";
      import { themeForScale } from "../lib/themes.ts";

      const BARS_PER_BLOCK = BARS / BLOCKS;

      const sourceSelect = document.querySelector<HTMLSelectElement>('[data-testid="editor-source-select"]')!;
      const targetSelect = document.querySelector<HTMLSelectElement>('[data-testid="editor-target-select"]')!;
      const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="editor-clear-button"]')!;
      const playButton = document.querySelector<HTMLButtonElement>('[data-testid="editor-play-button"]')!;
      const stopButton = document.querySelector<HTMLButtonElement>('[data-testid="editor-stop-button"]')!;
      const twinkleButton = document.querySelector<HTMLButtonElement>('[data-testid="editor-preset-twinkle"]')!;
      const joyButton = document.querySelector<HTMLButtonElement>('[data-testid="editor-preset-joy"]')!;
      const moliHuaButton = document.querySelector<HTMLButtonElement>('[data-testid="editor-preset-moli-hua"]')!;
      const transformedOutput = document.querySelector<HTMLOutputElement>('[data-testid="editor-transformed-notes"]')!;
      const keyboardEl = document.querySelector<HTMLDivElement>('[data-testid="editor-keyboard"]')!;
      const waveformCanvas = document.querySelector<HTMLCanvasElement>('[data-testid="editor-waveform"]')!;
      const waveformCtx = waveformCanvas.getContext("2d")!;
      const themeScope = document.querySelector<HTMLDivElement>('[data-testid="theme-scope"]')!;
      const blockContainers = Array.from(
        { length: BLOCKS },
        (_, i) => document.querySelector<HTMLDivElement>(`[data-testid="composition-grid-block-${i}"]`)!,
      );

      let composition: Composition = createEmptyComposition(sourceSelect.value);

      // Every mutation of `composition` routes through here so playback is
      // always stopped first -- editing while a performance is running would
      // otherwise let the played audio drift out of sync with what's now
      // displayed on the grid.
      function setComposition(next: Composition): void {
        stop();
        composition = next;
      }

      // Roving-tabindex focus position per block -- independent of Composition,
      // since it's UI state, not composition data. Keyed by block index.
      const focused: Record<number, { row: number; col: number }> = {};

      interface DragState {
        pointerId: number;
        blockIndex: number;
        scaleStep: number;
        anchorStep: number;
        currentStep: number;
        rowEl: HTMLElement;
        originLeft: number;
        cellWidth: number;
      }
      let drag: DragState | null = null;

      function currentRows(): number[] {
        return pitchRowsForComposition(composition).slice().sort((a, b) => b - a);
      }

      // Whether a distinct target style is selected -- the single switch
      // that decides both whether the second row-group renders at all and
      // whether the source group's cells go subdued. Kept as one source of
      // truth so the two can never disagree.
      function showTransformed(): boolean {
        return targetSelect.value !== composition.sourceScale;
      }

      function renderAll(): void {
        const rows = currentRows();
        const transformed = showTransformed() ? transformCompositionToTarget(composition, targetSelect.value) : null;
        const targetRows = transformed
          ? pitchRowsForComposition(transformed).slice().sort((a, b) => b - a)
          : [];
        blockContainers.forEach((container, blockIndex) =>
          renderBlock(container, blockIndex, rows, transformed, targetRows),
        );
        renderTransformedNotesText();
        applyTheme(); // every call site that can change targetSelect.value already calls renderAll()
      }

      function renderTransformedNotesText(): void {
        const events = renderComposition(composition, targetSelect.value, BEAT_SECONDS);
        transformedOutput.textContent = events.length
          ? events.map((event) => event.pitchName).join(", ")
          : "(nothing drawn yet)";
      }

      function renderBlock(
        container: HTMLDivElement,
        blockIndex: number,
        rows: number[],
        transformed: Composition | null,
        targetRows: number[],
      ): void {
        container.innerHTML = "";

        if (transformed) {
          const caption = document.createElement("p");
          caption.className = "row-group-caption";
          caption.textContent = "As written";
          container.appendChild(caption);
        }

        const sourceGrid = document.createElement("div");
        renderSourceGrid(sourceGrid, blockIndex, rows, transformed !== null);
        container.appendChild(sourceGrid);

        if (transformed) {
          const caption = document.createElement("p");
          caption.className = "row-group-caption";
          caption.textContent = `Transformed → ${targetSelect.value}`;
          container.appendChild(caption);

          const targetGrid = document.createElement("div");
          targetGrid.setAttribute("aria-hidden", "true");
          renderTargetGrid(targetGrid, blockIndex, targetRows, transformed);
          container.appendChild(targetGrid);
        }
      }

      function renderSourceGrid(
        gridEl: HTMLDivElement,
        blockIndex: number,
        rows: number[],
        subdued: boolean,
      ): void {
        gridEl.setAttribute("role", "grid");
        const barStart = blockIndex * BARS_PER_BLOCK + 1;
        const barEnd = barStart + BARS_PER_BLOCK - 1;
        gridEl.setAttribute("aria-label", `Bars ${barStart}–${barEnd}`);

        const focus = focused[blockIndex] ?? { row: 0, col: 0 };

        rows.forEach((scaleStep, rowIndex) => {
          const rowEl = document.createElement("div");
          rowEl.setAttribute("role", "row");
          rowEl.className = "grid-row";

          const label = pitchLabel(scaleStep, composition.sourceScale);

          const header = document.createElement("div");
          header.setAttribute("role", "rowheader");
          header.className = "row-header";
          header.textContent = label;
          rowEl.appendChild(header);

          for (let col = 0; col < STEPS_PER_BLOCK; col++) {
            const startStep = stepForBlockColumn(blockIndex, col);
            const occupant = noteAt(composition, scaleStep, startStep);
            const isNoteStart = occupant?.startStep === startStep;
            const isNoteEnd = occupant !== undefined && occupant.startStep + occupant.lengthSteps - 1 === startStep;

            const cell = document.createElement("button");
            cell.type = "button";
            cell.setAttribute("role", "gridcell");
            cell.setAttribute("aria-pressed", occupant ? "true" : "false");
            cell.className = "grid-cell";
            if (col % STEPS_PER_BAR === 0) cell.classList.add("bar-start");
            else if (col % STEPS_PER_BEAT === 0) cell.classList.add("beat-start");
            if (occupant) cell.classList.add("occupied");
            if (isNoteStart) cell.classList.add("note-start");
            if (isNoteEnd) cell.classList.add("note-end");
            if (subdued) cell.classList.add("subdued");

            const beatIndex = Math.floor(col / STEPS_PER_BEAT) + 1;
            const stepInBeat = (col % STEPS_PER_BEAT) + 1;
            cell.setAttribute("aria-label", `${label}, bars ${barStart}–${barEnd}, beat ${beatIndex} step ${stepInBeat}`);

            cell.tabIndex = rowIndex === focus.row && col === focus.col ? 0 : -1;
            cell.dataset.row = String(rowIndex);
            cell.dataset.col = String(col);

            attachCellHandlers(cell, blockIndex, scaleStep, startStep, rowIndex, col);

            rowEl.appendChild(cell);
          }
          gridEl.appendChild(rowEl);
        });
      }

      // Read-only mirror of renderSourceGrid for the transformed row-group:
      // plain <div> cells (no handlers, no tabindex), so there is no code
      // path by which interacting with this group could reach setComposition.
      // Reuses the same occupied/note-start/note-end/bar-start/beat-start
      // classes as the source grid, so a run of transformed notes fuses into
      // one continuous block exactly the same way.
      function renderTargetGrid(
        gridEl: HTMLDivElement,
        blockIndex: number,
        rows: number[],
        transformed: Composition,
      ): void {
        rows.forEach((scaleStep) => {
          const rowEl = document.createElement("div");
          rowEl.className = "grid-row";

          const header = document.createElement("div");
          header.className = "row-header";
          header.textContent = pitchLabel(scaleStep, targetSelect.value);
          rowEl.appendChild(header);

          for (let col = 0; col < STEPS_PER_BLOCK; col++) {
            const startStep = stepForBlockColumn(blockIndex, col);
            const occupant = noteAt(transformed, scaleStep, startStep);
            const isNoteStart = occupant?.startStep === startStep;
            const isNoteEnd = occupant !== undefined && occupant.startStep + occupant.lengthSteps - 1 === startStep;

            const cell = document.createElement("div");
            cell.className = "grid-cell readonly";
            if (col % STEPS_PER_BAR === 0) cell.classList.add("bar-start");
            else if (col % STEPS_PER_BEAT === 0) cell.classList.add("beat-start");
            if (occupant) cell.classList.add("occupied");
            if (isNoteStart) cell.classList.add("note-start");
            if (isNoteEnd) cell.classList.add("note-end");

            rowEl.appendChild(cell);
          }
          gridEl.appendChild(rowEl);
        });
      }

      function attachCellHandlers(
        cell: HTMLButtonElement,
        blockIndex: number,
        scaleStep: number,
        startStep: number,
        rowIndex: number,
        col: number,
      ): void {
        cell.addEventListener("pointerdown", (event) => {
          event.preventDefault();
          const occupant = noteAt(composition, scaleStep, startStep);
          if (occupant) {
            setComposition(removeNoteAt(composition, scaleStep, startStep));
            renderAll();
            return; // gesture consumed -- no drag begins on top of a removal
          }

          const rowEl = cell.parentElement as HTMLElement;
          const firstCell = rowEl.querySelector<HTMLButtonElement>('.grid-cell[data-col="0"]')!;
          const rect = firstCell.getBoundingClientRect();
          drag = {
            pointerId: event.pointerId,
            blockIndex,
            scaleStep,
            anchorStep: startStep,
            currentStep: startStep,
            rowEl,
            originLeft: rect.left,
            cellWidth: rect.width,
          };
          cell.setPointerCapture(event.pointerId);
          updateDragPreview();
        });

        cell.addEventListener("pointermove", (event) => {
          if (!drag || event.pointerId !== drag.pointerId) return;
          const localCol = Math.min(
            STEPS_PER_BLOCK - 1,
            Math.max(0, Math.round((event.clientX - drag.originLeft) / drag.cellWidth)),
          );
          const proposedEnd = stepForBlockColumn(drag.blockIndex, localCol);
          const clamped = clampDragEnd(composition, drag.scaleStep, drag.anchorStep, proposedEnd);
          if (clamped !== drag.currentStep) {
            drag.currentStep = clamped;
            updateDragPreview();
          }
        });

        const finishDrag = (event: PointerEvent): void => {
          if (!drag || event.pointerId !== drag.pointerId) return;
          setComposition(commitDrag(composition, drag.scaleStep, drag.anchorStep, drag.currentStep));
          drag = null;
          renderAll();
        };
        cell.addEventListener("pointerup", finishDrag);
        cell.addEventListener("pointercancel", finishDrag);

        cell.addEventListener("keydown", (event) => {
          switch (event.key) {
            case "ArrowRight":
              event.preventDefault();
              if (event.shiftKey) {
                const occupant = noteAt(composition, scaleStep, startStep);
                if (occupant) {
                  setComposition(resizeNote(composition, scaleStep, occupant.startStep, 1));
                  renderAll();
                  focusCell(blockIndex, rowIndex, col);
                }
              } else {
                moveFocus(blockIndex, rowIndex, col + 1);
              }
              break;
            case "ArrowLeft":
              event.preventDefault();
              if (event.shiftKey) {
                const occupant = noteAt(composition, scaleStep, startStep);
                if (occupant) {
                  setComposition(resizeNote(composition, scaleStep, occupant.startStep, -1));
                  renderAll();
                  focusCell(blockIndex, rowIndex, col);
                }
              } else {
                moveFocus(blockIndex, rowIndex, col - 1);
              }
              break;
            case "ArrowUp":
              event.preventDefault();
              moveFocus(blockIndex, rowIndex - 1, col);
              break;
            case "ArrowDown":
              event.preventDefault();
              moveFocus(blockIndex, rowIndex + 1, col);
              break;
            case "Enter":
            case " ":
              event.preventDefault();
              toggleCell(blockIndex, scaleStep, startStep, rowIndex, col);
              break;
            case "Delete":
            case "Backspace":
              event.preventDefault();
              if (noteAt(composition, scaleStep, startStep)) {
                setComposition(removeNoteAt(composition, scaleStep, startStep));
                renderAll();
                focusCell(blockIndex, rowIndex, col);
              }
              break;
          }
        });
      }

      function updateDragPreview(): void {
        if (!drag) return;
        const { rowEl, blockIndex, anchorStep, currentStep } = drag;
        const blockStart = blockIndex * STEPS_PER_BLOCK;
        const lo = Math.min(anchorStep, currentStep) - blockStart;
        const hi = Math.max(anchorStep, currentStep) - blockStart;
        rowEl.querySelectorAll<HTMLButtonElement>(".grid-cell").forEach((el) => {
          const col = Number(el.dataset.col);
          el.classList.toggle("drag-preview", col >= lo && col <= hi);
        });
      }

      function toggleCell(blockIndex: number, scaleStep: number, startStep: number, rowIndex: number, col: number): void {
        const occupant = noteAt(composition, scaleStep, startStep);
        setComposition(
          occupant
            ? removeNoteAt(composition, scaleStep, startStep)
            : commitDrag(composition, scaleStep, startStep, startStep),
        );
        renderAll();
        focusCell(blockIndex, rowIndex, col);
      }

      function moveFocus(blockIndex: number, row: number, col: number): void {
        const rows = currentRows();
        const clampedRow = Math.max(0, Math.min(rows.length - 1, row));
        const clampedCol = Math.max(0, Math.min(STEPS_PER_BLOCK - 1, col));
        focusCell(blockIndex, clampedRow, clampedCol);
      }

      function focusCell(blockIndex: number, row: number, col: number): void {
        focused[blockIndex] = { row, col };
        const container = blockContainers[blockIndex];
        container.querySelectorAll<HTMLButtonElement>(".grid-cell").forEach((el) => {
          const isTarget = Number(el.dataset.row) === row && Number(el.dataset.col) === col;
          el.tabIndex = isTarget ? 0 : -1;
        });
        container.querySelector<HTMLButtonElement>(`.grid-cell[data-row="${row}"][data-col="${col}"]`)?.focus();
      }

      // Static: built once from keyboardKeys() and never re-rendered, since
      // the key layout never changes -- only .active classes toggle at
      // runtime. Each black key nests inside the white key immediately
      // before it, absolutely positioned by CSS on the boundary between the
      // two -- simpler than computing container-relative pixel offsets.
      function renderKeyboard(): void {
        keyboardEl.innerHTML = "";
        const keys = keyboardKeys();
        for (let i = 0; i < keys.length; i++) {
          const key = keys[i];
          if (key.isBlack) continue; // consumed as a child of the preceding white key below

          const whiteEl = document.createElement("div");
          whiteEl.className = "piano-key white";
          whiteEl.dataset.pitch = key.pitchName;
          if (key.pitchName.startsWith("C")) {
            const label = document.createElement("span");
            label.className = "piano-key-label";
            label.textContent = key.pitchName;
            whiteEl.appendChild(label);
          }

          const next = keys[i + 1];
          if (next?.isBlack) {
            const blackEl = document.createElement("div");
            blackEl.className = "piano-key black";
            blackEl.dataset.pitch = next.pitchName;
            whiteEl.appendChild(blackEl);
          }

          keyboardEl.appendChild(whiteEl);
        }
      }

      // Reference-counted so a pitch sounding from more than one overlapping
      // event (polyphony, or two voices sharing a pitch) stays lit until
      // every voice has ended, not just the first -- see keyboard.ts.
      let voiceCounts: VoiceCounts = {};

      function setKeyActive(pitchName: string, active: boolean): void {
        keyboardEl.querySelector(`[data-pitch="${pitchName}"]`)?.classList.toggle("active", active);
      }

      // Oscilloscope waveform: driven by the real Web Audio signal via
      // AnalyserNode.getByteTimeDomainData(), polled every animation frame --
      // not by noteStart/noteEnd events, which mark boundaries but say
      // nothing about the signal in between. Only lifecycle (when to
      // start/stop/reset) reuses the same playerEvents "stop" this page's
      // keyboard already relies on.
      const prefersReducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
      let rafId: number | null = null;
      let intervalId: ReturnType<typeof setInterval> | null = null;
      let animGeneration = 0;

      function resizeWaveformCanvas(): void {
        const rect = waveformCanvas.getBoundingClientRect();
        const ratio = window.devicePixelRatio || 1;
        waveformCanvas.width = Math.max(1, Math.round(rect.width * ratio));
        waveformCanvas.height = Math.max(1, Math.round(rect.height * ratio));
      }

      // Refreshed once per theme change (see applyTheme below), never per
      // animation frame -- a getComputedStyle call on every one of 60
      // frames/sec would be wasted cost when the theme only actually changes
      // on a Target style select event.
      let waveStyle = { color: "#0b5fff", glow: "transparent", width: 2 };

      function refreshWaveStyle(): void {
        const cs = getComputedStyle(themeScope);
        waveStyle = {
          color: cs.getPropertyValue("--theme-wave").trim() || waveStyle.color,
          glow: cs.getPropertyValue("--theme-wave-glow").trim() || "transparent",
          width: parseFloat(cs.getPropertyValue("--theme-wave-width")) || 2,
        };
      }

      // The single place Target style resolves to a visual theme -- every
      // other function only ever reads themeScope.dataset.scaleTheme or the
      // CSS custom properties it drives, never branches on a scale name
      // itself (see themes.ts).
      function applyTheme(): void {
        themeScope.dataset.scaleTheme = themeForScale(targetSelect.value).id;
        refreshWaveStyle();
      }

      function paintWaveform(points: Array<[number, number]>): void {
        const { width, height } = waveformCanvas;
        waveformCtx.clearRect(0, 0, width, height);
        waveformCtx.strokeStyle = waveStyle.color;
        waveformCtx.lineWidth = waveStyle.width;
        waveformCtx.lineCap = "round";
        waveformCtx.shadowColor = waveStyle.glow;
        waveformCtx.shadowBlur = waveStyle.glow === "transparent" ? 0 : 6;
        waveformCtx.beginPath();
        points.forEach(([x, y], i) => (i === 0 ? waveformCtx.moveTo(x, y) : waveformCtx.lineTo(x, y)));
        waveformCtx.stroke();
      }

      function drawIdleWaveform(): void {
        paintWaveform(idlePoints(waveformCanvas.width, waveformCanvas.height));
      }

      function drawLiveWaveformFrame(analyser: AnalyserNode, data: Uint8Array<ArrayBuffer>): void {
        analyser.getByteTimeDomainData(data);
        paintWaveform(waveformPoints(data, waveformCanvas.width, waveformCanvas.height));
      }

      // Only ever called right after playEvents() -- never before the first
      // Play click -- so no analyser/animation loop exists until the visitor
      // presses Play, per the no-autoplay rule this whole page follows.
      function startVisualizer(): void {
        const analyser = getAnalyser();
        if (!analyser) return;
        animGeneration++;
        const gen = animGeneration;
        const data = new Uint8Array(analyser.fftSize);

        if (prefersReducedMotion.matches) {
          // Real signal, throttled to 2/sec rather than continuous 60fps --
          // still responds to what's playing, without a distracting
          // continuous animation.
          intervalId = setInterval(() => {
            if (gen !== animGeneration) return;
            drawLiveWaveformFrame(analyser, data);
          }, 500);
        } else {
          const frame = () => {
            if (gen !== animGeneration) return;
            drawLiveWaveformFrame(analyser, data);
            rafId = requestAnimationFrame(frame);
          };
          rafId = requestAnimationFrame(frame);
        }
      }

      // Covers every case that must reset the waveform: the Stop button,
      // natural completion, and every setComposition/target-style-change
      // call site -- all of them already dispatch playerEvents "stop" (see
      // audio.ts), so this is the only place that needs to know the
      // visualizer exists. Bumping animGeneration here, before a restart's
      // own startVisualizer() runs, is what stops a Play click mid-performance
      // from leaving a stale loop behind (see playEvents()'s doc comment).
      function stopVisualizer(): void {
        animGeneration++;
        if (rafId !== null) cancelAnimationFrame(rafId);
        rafId = null;
        if (intervalId !== null) clearInterval(intervalId);
        intervalId = null;
        drawIdleWaveform();
      }

      playerEvents.addEventListener("stop", stopVisualizer);

      window.addEventListener("resize", () => {
        resizeWaveformCanvas();
        if (rafId === null && intervalId === null) drawIdleWaveform(); // mid-playback frames self-correct next tick
      });

      // One subscription, once, covers every lifecycle case: Stop,
      // Play-while-playing, edits/Clear/preset-load/Source-Style-change (all
      // route through setComposition, which calls stop() first), Target
      // Style change (calls stop() directly), and natural completion --
      // every one of those already dispatches through audio.ts's
      // playerEvents, so no other call site needs to know the keyboard
      // exists at all.
      playerEvents.addEventListener("noteStart", (event) => {
        const { pitchName } = (event as CustomEvent).detail;
        voiceCounts = withVoiceStarted(voiceCounts, pitchName);
        setKeyActive(pitchName, true);
      });
      playerEvents.addEventListener("noteEnd", (event) => {
        const { pitchName } = (event as CustomEvent).detail;
        voiceCounts = withVoiceEnded(voiceCounts, pitchName);
        setKeyActive(pitchName, pitchName in voiceCounts);
      });
      playerEvents.addEventListener("stop", () => {
        for (const pitchName of Object.keys(voiceCounts)) setKeyActive(pitchName, false);
        voiceCounts = {};
      });

      sourceSelect.addEventListener("change", () => {
        setComposition(createEmptyComposition(sourceSelect.value));
        targetSelect.value = sourceSelect.value; // both styles start in sync; only diverge when explicitly changed
        for (const key of Object.keys(focused)) delete focused[Number(key)];
        renderAll();
      });

      clearButton.addEventListener("click", () => {
        setComposition(createEmptyComposition(composition.sourceScale));
        targetSelect.value = composition.sourceScale;
        renderAll();
      });

      // Loads a preset melody straight into the editor: auto-selects Source
      // Style to match, resets Target Style to the same value so the user
      // hears/sees the original first, and replaces (never merges with)
      // whatever was on the grid before -- setComposition assigns a wholly
      // new Composition, and stops playback first, same as every other
      // mutation. Once loaded, the notes are ordinary CompositionNote
      // entries with no special-casing, so they're editable like anything
      // hand-drawn.
      function loadPreset(melody: Melody): void {
        setComposition(sequentialToComposition(melody));
        sourceSelect.value = melody.sourceScale;
        targetSelect.value = melody.sourceScale;
        for (const key of Object.keys(focused)) delete focused[Number(key)];
        renderAll();
      }

      twinkleButton.addEventListener("click", () => loadPreset(TWINKLE_TWINKLE));
      joyButton.addEventListener("click", () => loadPreset(JOY_TO_THE_WORLD));
      moliHuaButton.addEventListener("click", () => loadPreset(MO_LI_HUA));

      // Target style is pure render/UI state, never assigned onto
      // `composition` -- changing it can only ever move where notes are
      // drawn/played, never mutate or clear the source composition.
      targetSelect.addEventListener("change", () => {
        stop();
        renderAll();
      });

      playButton.addEventListener("click", () => {
        playEvents(renderComposition(composition, targetSelect.value, BEAT_SECONDS));
        startVisualizer();
      });
      stopButton.addEventListener("click", stop);

      renderKeyboard();
      renderAll();
      resizeWaveformCanvas();
      drawIdleWaveform();
    </script>

    <style>
      main {
        max-width: none;
        margin: 0;
      }

      .intro {
        max-width: 40rem;
        margin: 0 auto 2rem;
        box-sizing: border-box;
      }

      .hint {
        color: var(--theme-muted, #555);
        font-size: 0.9rem;
      }

      /* The entire interactive region lives inside .world -- its background,
         texture, and every panel within it change with Target style. .intro
         above stays a fixed neutral zone regardless of theme. isolation
         creates a stacking context so ::before's texture layer (z-index: 0)
         reliably sits behind .world-inner's content (z-index: 1) without
         needing z-index values coordinated against anything outside .world. */
      .world {
        position: relative;
        isolation: isolate;
        box-sizing: border-box;
        overflow-x: hidden;
        overflow-x: clip;
        background-color: var(--theme-bg, #fff);
        color: var(--theme-text, #1a1a1a);
        border-radius: 20px;
        padding: 2rem 1.5rem 2.5rem;
        transition: background-color 200ms ease;
      }

      .world::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: var(--theme-world-texture, none);
        opacity: var(--theme-texture-strength, 0.5);
      }

      .world-inner {
        position: relative;
        z-index: 1;
        max-width: 72rem;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
      }

      .panel {
        box-sizing: border-box;
        background: var(--theme-surface, #fff);
        border: 1px solid var(--theme-border, #ccc);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 4px 18px var(--theme-shadow, rgba(0, 0, 0, 0.1));
      }

      .panel h2 {
        margin: 0 0 0.75rem;
        font-size: 1.05rem;
        letter-spacing: 0.02em;
      }

      /* Presets, restyled as track cards rather than a flat button row --
         still real <button type="button"> elements, only the CSS changed. */
      .preset-tracks {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
      }

      .track-button {
        box-sizing: border-box;
        background: var(--theme-surface-elevated, #f5f5f5);
        color: var(--theme-text, #1a1a1a);
        border: 1px solid var(--theme-border, #ccc);
        border-radius: 999px;
        padding: 0.55rem 1.15rem;
        font: inherit;
        font-size: 0.9rem;
        cursor: pointer;
        transition:
          border-color 150ms ease,
          transform 100ms ease,
          background-color 150ms ease;
      }

      .track-button:hover {
        border-color: var(--theme-accent, #888);
      }

      .track-button:active {
        transform: scale(0.97);
      }

      .track-button:focus-visible {
        outline: 2px solid #ff8c00;
        outline-offset: 2px;
      }

      .track-button--clear {
        border-style: dashed;
      }

      /* Source/Target style controls, grouped in one panel with a
         Source -> Target connector glyph -- still real <select> elements,
         only appearance:none + a CSS chevron replace the browser default. */
      .style-form {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 1rem;
        margin: 0 0 0.75rem;
      }

      .style-field {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        font-size: 0.9rem;
      }

      .style-field select {
        box-sizing: border-box;
        appearance: none;
        background-color: var(--theme-surface-elevated, #fff);
        color: var(--theme-text, #1a1a1a);
        border: 1px solid var(--theme-border, #ccc);
        border-radius: 8px;
        padding: 0.5rem 2rem 0.5rem 0.75rem;
        font: inherit;
        font-size: 0.95rem;
        background-image:
          linear-gradient(45deg, transparent 50%, currentcolor 50%),
          linear-gradient(135deg, currentcolor 50%, transparent 50%);
        background-position:
          calc(100% - 14px) calc(50% - 3px),
          calc(100% - 9px) calc(50% - 3px);
        background-size: 5px 5px, 5px 5px;
        background-repeat: no-repeat;
      }

      .style-field select:focus-visible {
        outline: 2px solid #ff8c00;
        outline-offset: 2px;
      }

      .style-connector {
        align-self: center;
        padding-bottom: 0.5rem;
        font-size: 1.3rem;
        color: var(--theme-accent, #888);
      }

      .transport {
        display: flex;
        gap: 0.75rem;
      }

      .transport-button {
        box-sizing: border-box;
        border-radius: 999px;
        padding: 0.65rem 1.85rem;
        font: inherit;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        border: 2px solid var(--theme-accent, #888);
        transition:
          background-color 150ms ease,
          transform 100ms ease;
      }

      .transport-button--play {
        background: var(--theme-accent, #0b5fff);
        color: var(--theme-surface, #fff);
      }

      .transport-button--stop {
        background: transparent;
        color: var(--theme-text, #1a1a1a);
      }

      .transport-button:active {
        transform: scale(0.96);
      }

      .transport-button:focus-visible {
        outline: 2px solid #ff8c00;
        outline-offset: 2px;
      }

      .waveform-panel {
        position: relative;
        box-sizing: border-box;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid var(--theme-border, #ccc);
        background: var(--theme-surface, #fafafa);
        box-shadow: 0 6px 22px var(--theme-shadow, rgba(0, 0, 0, 0.15));
        padding: 0.5rem;
      }

      .waveform-panel::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: var(--theme-world-texture, none);
        opacity: calc(var(--theme-texture-strength, 0.5) * 0.7);
      }

      /* No overflow-x wrapper needed for the canvas itself -- it has no
         fixed-width children to overflow, it just respects width: 100%
         directly; its backing resolution is set from this rendered size in
         the script above. Transparent background (rather than the previous
         opaque theme-bg fill) is what lets .waveform-panel's ::before show
         through the whole bitmap -- paintWaveform's clearRect never leaves
         an opaque pixel behind. */
      [data-testid="editor-waveform"] {
        position: relative;
        display: block;
        width: 100%;
        height: 16rem;
        background: transparent;
      }

      /* Fixed-width keys (see is:global below) mean the keyboard can be
         wider than a narrow viewport -- scrolls internally, same pattern as
         .grid-scroll, rather than causing page-level horizontal scroll. */
      .piano-scroll {
        box-sizing: border-box;
        overflow-x: auto;
        border: 1px solid var(--theme-border, #ccc);
        border-radius: 12px;
        background: var(--theme-surface, #fff);
        box-shadow: 0 4px 16px var(--theme-shadow, rgba(0, 0, 0, 0.12));
        padding: 0.75rem;
      }

      .blocks {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .editor-block h3 {
        font-size: 0.85rem;
        margin: 0 0 0.15rem;
        color: var(--theme-muted, #666);
        font-weight: 600;
      }

      .grid-scroll {
        overflow-x: auto;
        border: 1px solid var(--theme-border, #ccc);
        border-radius: 6px;
        background: var(--theme-surface-elevated, #fff);
      }

      .row-group-caption {
        margin: 0.35rem 0.25rem 0.15rem;
        font-size: 0.7rem;
        font-weight: bold;
        color: var(--theme-muted, #444);
      }

      @media (max-width: 37.5em) {
        .world {
          padding: 1.25rem 1rem 1.75rem;
          border-radius: 14px;
        }

        .world-inner {
          gap: 1.25rem;
        }

        .world::before {
          opacity: calc(var(--theme-texture-strength, 0.5) * 0.5);
        }

        [data-testid="editor-waveform"] {
          height: 10rem;
        }

        .panel {
          padding: 1rem;
        }
      }
    </style>

    <!--
      Every element below is created at runtime via document.createElement in
      the script above, never written in this file's markup. Astro's scoped
      styles only rewrite selectors to match elements present in the compiled
      template -- a data-astro-cid-* attribute it has no way to stamp onto
      elements the browser creates later -- so a scoped <style> here would
      silently match nothing on the actual grid. is:global is required, not
      a style preference.
    -->
    <style is:global>
      .grid-row {
        display: flex;
      }

      /* 64 columns per block (4 bars x 16 sixteenth-notes -- BARS_PER_BLOCK,
         not the 32 an earlier pass assumed) means the header must be a hard
         fixed width: box-sizing: border-box alone doesn't stop a flex item
         from growing past its flex-basis to fit text content, so width +
         min-width pin it and overflow/white-space clip a too-long pitch
         label rather than pushing the whole row wider. */
      .row-header {
        position: sticky;
        left: 0;
        flex: 0 0 2rem;
        width: 2rem;
        min-width: 2rem;
        box-sizing: border-box;
        overflow: hidden;
        white-space: nowrap;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--theme-surface-elevated, #f5f5f5);
        color: var(--theme-text, #1a1a1a);
        border-right: 1px solid var(--theme-border, #999);
        font-size: 0.65rem;
        padding: 0 0.15rem;
      }

      /* box-sizing must be explicit: renderSourceGrid's cells are real
         <button>s (border-box by default in the UA stylesheet), but
         renderTargetGrid's read-only mirror cells are plain <div>s
         (content-box by default) -- without this, the two row-groups'
         cells are actually different widths once borders are counted, and
         the target group's rows silently overflow .grid-scroll. */
      .grid-cell {
        box-sizing: border-box;
        flex: 0 0 1rem;
        height: 1rem;
        min-width: 1rem;
        min-height: 1rem;
        border: none;
        border-right: 1px solid var(--theme-grid-line, #e0e0e0);
        border-bottom: 1px solid var(--theme-grid-line, #e0e0e0);
        background: var(--theme-surface-elevated, #fff);
        padding: 0;
        cursor: pointer;
      }

      /* bar-start/beat-start mark the FIRST cell of a new bar/beat, so the
         divider must sit on that cell's LEFT edge -- immediately before its
         startStep -- not its right edge, which would draw the line one
         sixteenth late and make the whole timeline look shifted by one step. */
      .grid-cell.beat-start {
        border-left: 1px solid var(--theme-border, #b0b0b0);
      }

      .grid-cell.bar-start {
        border-left: 2px solid var(--theme-text, #555);
      }

      /* A run of occupied cells belonging to one note must read as a single
         unbroken rectangle, not a row of separately-bordered cells -- the
         internal border-right/bottom is overridden to match the fill so
         adjacent occupied cells fuse into one block; only the note's outer
         edges (note-start/note-end) get a border and rounded corner. */
      .grid-cell.occupied {
        background: var(--theme-note, #0b5fff);
        border-right-color: var(--theme-note, #0b5fff);
        border-bottom-color: var(--theme-note, #0b5fff);
      }

      .grid-cell.note-start {
        border-left: 2px solid var(--theme-note-outline, #063a9e);
        border-top-left-radius: 4px;
        border-bottom-left-radius: 4px;
      }

      .grid-cell.note-end {
        border-right: 2px solid var(--theme-note-outline, #063a9e);
        border-top-right-radius: 4px;
        border-bottom-right-radius: 4px;
      }

      .grid-cell.drag-preview {
        background: var(--theme-accent-secondary, #9dc0ff);
      }

      .grid-cell:focus-visible {
        outline: 2px solid #ff8c00;
        outline-offset: -2px;
      }

      /* Source-group notes, shown outlined-only once a differing target
         style is selected -- the originally-entered notes stay visible but
         visually subordinate to the transformed group's solid fill below. */
      .grid-cell.subdued.occupied {
        background: transparent;
        border-top: 1px solid var(--theme-accent-secondary, #0b5fff);
        border-right-color: var(--theme-accent-secondary, #0b5fff);
        border-bottom-color: var(--theme-accent-secondary, #0b5fff);
      }

      .grid-cell.readonly {
        cursor: default;
      }

      @media (max-width: 37.5em) {
        .grid-cell {
          height: 1.5rem;
          min-height: 1.5rem;
        }
      }

      /* Fixed-width white keys (rather than flex-growing to fill the
         container) so keys stay a usable, recognizable size at any
         viewport -- .piano-scroll above handles the resulting overflow on
         narrow screens. Each black key is a child of the white key
         immediately before it, positioned on the boundary between the two;
         a simplification of a real piano's slightly-offset black keys, but
         correctly grouped and unambiguous. */
      .piano {
        display: flex;
        height: 5rem;
      }

      .piano-key.white {
        position: relative;
        flex: 0 0 1.8rem;
        height: 100%;
        background: #fff;
        border: 1px solid #999;
        margin-left: -1px;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding-bottom: 0.25rem;
        box-sizing: border-box;
      }

      .piano-key-label {
        font-size: 0.65rem;
        color: #777;
        pointer-events: none;
      }

      .piano-key.black {
        position: absolute;
        top: 0;
        left: 100%;
        transform: translateX(-50%);
        width: 65%;
        height: 60%;
        background: #222;
        border: 1px solid #000;
        border-radius: 0 0 3px 3px;
        z-index: 2;
      }

      .piano-key.white.active {
        background: var(--theme-key-active-white, #9dc0ff);
        box-shadow: 0 0 10px var(--theme-accent, transparent);
      }

      .piano-key.black.active {
        background: var(--theme-key-active-black, #0b5fff);
        box-shadow: 0 0 10px var(--theme-accent, transparent);
      }
    </style>
  </body>
</html>
