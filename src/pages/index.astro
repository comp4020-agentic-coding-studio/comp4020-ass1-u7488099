---
import "../styles/global.css";
import { JOY_TO_THE_WORLD, MO_LI_HUA, TWINKLE_TWINKLE } from "../lib/melodies.ts";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>One Melody, Many Worlds</title>
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
    </header>
    <main>
      <h1>One Melody, Many Worlds</h1>
      <p>
        Pick a scale. The melody stays the same — same notes, same rhythm,
        same starting pitch — only the scale each note is drawn from
        changes. A scale is one ingredient of a musical tradition, not the
        whole thing: this isn't "this melody, but Chinese/Japanese/Arabic,"
        it's the same tune reinterpreted through a different set of
        intervals.
      </p>

      <form>
        <p>
          <label>
            Melody
            <select data-testid="melody-select" name="melody">
              <option value="twinkle">{TWINKLE_TWINKLE.name}</option>
              <option value="joy">{JOY_TO_THE_WORLD.name}</option>
              <option value="moliHua">{MO_LI_HUA.name}</option>
            </select>
          </label>
        </p>

        <p>
          <label>
            Scale
            <select data-testid="scale-select" name="scale">
              <option value="Major">Major</option>
              <option value="Natural Minor">Natural Minor</option>
              <option value="Harmonic Minor">Harmonic Minor</option>
              <option value="Melodic Minor (ascending)">Melodic Minor (ascending)</option>
              <option value="Dorian">Dorian</option>
              <option value="Phrygian">Phrygian</option>
              <option value="Hijaz">Hijaz</option>
              <option value="Major Pentatonic">Major Pentatonic (experimental)</option>
              <option value="In Sen">In Sen (experimental)</option>
            </select>
          </label>
        </p>

        <p>
          <button type="button" data-testid="play-button">Play</button>
        </p>
      </form>

      <p>
        Transformed notes:
        <output data-testid="transformed-notes"></output>
      </p>
    </main>

    <script>
      import { JOY_TO_THE_WORLD, MO_LI_HUA, TWINKLE_TWINKLE } from "../lib/melodies.ts";
      import { transformMelody } from "../lib/transform.ts";
      import { playNotes } from "../lib/audio.ts";

      const melodies = { twinkle: TWINKLE_TWINKLE, joy: JOY_TO_THE_WORLD, moliHua: MO_LI_HUA };

      const melodySelect = document.querySelector<HTMLSelectElement>('[data-testid="melody-select"]')!;
      const scaleSelect = document.querySelector<HTMLSelectElement>('[data-testid="scale-select"]')!;
      const playButton = document.querySelector<HTMLButtonElement>('[data-testid="play-button"]')!;
      const output = document.querySelector<HTMLOutputElement>('[data-testid="transformed-notes"]')!;

      function currentMelody() {
        return melodies[melodySelect.value as keyof typeof melodies];
      }

      function currentTransformedPitches(): string[] {
        return transformMelody(currentMelody(), scaleSelect.value);
      }

      function render(): void {
        output.textContent = currentTransformedPitches().join(" ");
      }

      melodySelect.addEventListener("change", render);
      scaleSelect.addEventListener("change", render);

      playButton.addEventListener("click", () => {
        const melody = currentMelody();
        const durations = melody.notes.map((note) => note.duration);
        playNotes(currentTransformedPitches(), durations);
      });

      render();
    </script>
  </body>
</html>
