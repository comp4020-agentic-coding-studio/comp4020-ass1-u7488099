---
import "../styles/global.css";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Composition Editor — One Melody, Many Worlds</title>
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="../">Home</a>
      </nav>
    </header>
    <main>
      <h1>Composition Editor</h1>
      <p>
        Click or drag across a row to place a note; click a note to remove
        it. Arrow keys move focus, Enter/Space places or removes a note, and
        Shift + Arrow resizes one.
      </p>

      <section aria-label="Presets">
        <h2>Presets</h2>
        <p>
          <button type="button" data-testid="editor-preset-twinkle">Twinkle Twinkle Little Star</button>
          <button type="button" data-testid="editor-preset-joy">Joy to the World</button>
          <button type="button" data-testid="editor-preset-moli-hua">Mo Li Hua / 茉莉花</button>
          <button type="button" data-testid="editor-clear-button">Clear / New Composition</button>
        </p>
      </section>

      <form>
        <p>
          <label>
            Style
            <select data-testid="editor-source-select" name="source-scale">
              <option value="Major">Major</option>
              <option value="Natural Minor">Natural Minor</option>
              <option value="Harmonic Minor">Harmonic Minor</option>
              <option value="Melodic Minor (ascending)">Melodic Minor (ascending)</option>
              <option value="Dorian">Dorian</option>
              <option value="Phrygian">Phrygian</option>
              <option value="Hijaz">Hijaz</option>
              <option value="Major Pentatonic">Major Pentatonic (experimental)</option>
              <option value="In Sen">In Sen (experimental)</option>
            </select>
          </label>
        </p>
        <p class="hint">Changing style clears your composition.</p>

        <p>
          <label>
            Target style
            <select data-testid="editor-target-select" name="target-scale">
              <option value="Major">Major</option>
              <option value="Natural Minor">Natural Minor</option>
              <option value="Harmonic Minor">Harmonic Minor</option>
              <option value="Melodic Minor (ascending)">Melodic Minor (ascending)</option>
              <option value="Dorian">Dorian</option>
              <option value="Phrygian">Phrygian</option>
              <option value="Hijaz">Hijaz</option>
              <option value="Major Pentatonic">Major Pentatonic (experimental)</option>
              <option value="In Sen">In Sen (experimental)</option>
            </select>
          </label>
        </p>
        <p class="hint">
          When target style differs from style, a second row group below shows where your notes move; Play plays
          the transformed result.
        </p>

        <p>
          <button type="button" data-testid="editor-play-button">Play</button>
          <button type="button" data-testid="editor-stop-button">Stop</button>
        </p>

        <p>
          Transformed notes:
          <output data-testid="editor-transformed-notes"></output>
        </p>
      </form>

      <div class="blocks">
        {
          Array.from({ length: 4 }, (_, blockIndex) => (
            <section class="editor-block">
              <h2>
                Bars {blockIndex * 2 + 1}–{blockIndex * 2 + 2}
              </h2>
              <div class="grid-scroll">
                <div data-testid={`composition-grid-block-${blockIndex}`} />
              </div>
            </section>
          ))
        }
      </div>
    </main>

    <script>
      import {
        BARS,
        type Composition,
        createEmptyComposition,
        pitchRowsForComposition,
        renderComposition,
        sequentialToComposition,
        STEPS_PER_BAR,
        STEPS_PER_BEAT,
        transformCompositionToTarget,
      } from "../lib/composition.ts";
      import {
        BLOCKS,
        clampDragEnd,
        commitDrag,
        noteAt,
        pitchLabel,
        removeNoteAt,
        resizeNote,
        stepForBlockColumn,
        STEPS_PER_BLOCK,
      } from "../lib/editorGrid.ts";
      import { BEAT_SECONDS, playEvents, stop } from "../lib/audio.ts";
      import { JOY_TO_THE_WORLD, MO_LI_HUA, type Melody, TWINKLE_TWINKLE } from "../lib/melodies.ts";

      const BARS_PER_BLOCK = BARS / BLOCKS;

      const sourceSelect = document.querySelector<HTMLSelectElement>('[data-testid="editor-source-select"]')!;
      const targetSelect = document.querySelector<HTMLSelectElement>('[data-testid="editor-target-select"]')!;
      const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="editor-clear-button"]')!;
      const playButton = document.querySelector<HTMLButtonElement>('[data-testid="editor-play-button"]')!;
      const stopButton = document.querySelector<HTMLButtonElement>('[data-testid="editor-stop-button"]')!;
      const twinkleButton = document.querySelector<HTMLButtonElement>('[data-testid="editor-preset-twinkle"]')!;
      const joyButton = document.querySelector<HTMLButtonElement>('[data-testid="editor-preset-joy"]')!;
      const moliHuaButton = document.querySelector<HTMLButtonElement>('[data-testid="editor-preset-moli-hua"]')!;
      const transformedOutput = document.querySelector<HTMLOutputElement>('[data-testid="editor-transformed-notes"]')!;
      const blockContainers = Array.from(
        { length: BLOCKS },
        (_, i) => document.querySelector<HTMLDivElement>(`[data-testid="composition-grid-block-${i}"]`)!,
      );

      let composition: Composition = createEmptyComposition(sourceSelect.value);

      // Every mutation of `composition` routes through here so playback is
      // always stopped first -- editing while a performance is running would
      // otherwise let the played audio drift out of sync with what's now
      // displayed on the grid, the same "no autoplay/no stale sound" logic
      // index.astro applies on its own select-change handlers.
      function setComposition(next: Composition): void {
        stop();
        composition = next;
      }

      // Roving-tabindex focus position per block -- independent of Composition,
      // since it's UI state, not composition data. Keyed by block index.
      const focused: Record<number, { row: number; col: number }> = {};

      interface DragState {
        pointerId: number;
        blockIndex: number;
        scaleStep: number;
        anchorStep: number;
        currentStep: number;
        rowEl: HTMLElement;
        originLeft: number;
        cellWidth: number;
      }
      let drag: DragState | null = null;

      function currentRows(): number[] {
        return pitchRowsForComposition(composition).slice().sort((a, b) => b - a);
      }

      // Whether a distinct target style is selected -- the single switch
      // that decides both whether the second row-group renders at all and
      // whether the source group's cells go subdued. Kept as one source of
      // truth so the two can never disagree.
      function showTransformed(): boolean {
        return targetSelect.value !== composition.sourceScale;
      }

      function renderAll(): void {
        const rows = currentRows();
        const transformed = showTransformed() ? transformCompositionToTarget(composition, targetSelect.value) : null;
        const targetRows = transformed
          ? pitchRowsForComposition(transformed).slice().sort((a, b) => b - a)
          : [];
        blockContainers.forEach((container, blockIndex) =>
          renderBlock(container, blockIndex, rows, transformed, targetRows),
        );
        renderTransformedNotesText();
      }

      function renderTransformedNotesText(): void {
        const events = renderComposition(composition, targetSelect.value, BEAT_SECONDS);
        transformedOutput.textContent = events.length
          ? events.map((event) => event.pitchName).join(", ")
          : "(nothing drawn yet)";
      }

      function renderBlock(
        container: HTMLDivElement,
        blockIndex: number,
        rows: number[],
        transformed: Composition | null,
        targetRows: number[],
      ): void {
        container.innerHTML = "";

        if (transformed) {
          const caption = document.createElement("p");
          caption.className = "row-group-caption";
          caption.textContent = "As written";
          container.appendChild(caption);
        }

        const sourceGrid = document.createElement("div");
        renderSourceGrid(sourceGrid, blockIndex, rows, transformed !== null);
        container.appendChild(sourceGrid);

        if (transformed) {
          const caption = document.createElement("p");
          caption.className = "row-group-caption";
          caption.textContent = `Transformed → ${targetSelect.value}`;
          container.appendChild(caption);

          const targetGrid = document.createElement("div");
          targetGrid.setAttribute("aria-hidden", "true");
          renderTargetGrid(targetGrid, blockIndex, targetRows, transformed);
          container.appendChild(targetGrid);
        }
      }

      function renderSourceGrid(
        gridEl: HTMLDivElement,
        blockIndex: number,
        rows: number[],
        subdued: boolean,
      ): void {
        gridEl.setAttribute("role", "grid");
        const barStart = blockIndex * BARS_PER_BLOCK + 1;
        const barEnd = barStart + BARS_PER_BLOCK - 1;
        gridEl.setAttribute("aria-label", `Bars ${barStart}–${barEnd}`);

        const focus = focused[blockIndex] ?? { row: 0, col: 0 };

        rows.forEach((scaleStep, rowIndex) => {
          const rowEl = document.createElement("div");
          rowEl.setAttribute("role", "row");
          rowEl.className = "grid-row";

          const label = pitchLabel(scaleStep, composition.sourceScale);

          const header = document.createElement("div");
          header.setAttribute("role", "rowheader");
          header.className = "row-header";
          header.textContent = label;
          rowEl.appendChild(header);

          for (let col = 0; col < STEPS_PER_BLOCK; col++) {
            const startStep = stepForBlockColumn(blockIndex, col);
            const occupant = noteAt(composition, scaleStep, startStep);
            const isNoteStart = occupant?.startStep === startStep;
            const isNoteEnd = occupant !== undefined && occupant.startStep + occupant.lengthSteps - 1 === startStep;

            const cell = document.createElement("button");
            cell.type = "button";
            cell.setAttribute("role", "gridcell");
            cell.setAttribute("aria-pressed", occupant ? "true" : "false");
            cell.className = "grid-cell";
            if (col % STEPS_PER_BAR === 0) cell.classList.add("bar-start");
            else if (col % STEPS_PER_BEAT === 0) cell.classList.add("beat-start");
            if (occupant) cell.classList.add("occupied");
            if (isNoteStart) cell.classList.add("note-start");
            if (isNoteEnd) cell.classList.add("note-end");
            if (subdued) cell.classList.add("subdued");

            const beatIndex = Math.floor(col / STEPS_PER_BEAT) + 1;
            const stepInBeat = (col % STEPS_PER_BEAT) + 1;
            cell.setAttribute("aria-label", `${label}, bars ${barStart}–${barEnd}, beat ${beatIndex} step ${stepInBeat}`);

            cell.tabIndex = rowIndex === focus.row && col === focus.col ? 0 : -1;
            cell.dataset.row = String(rowIndex);
            cell.dataset.col = String(col);

            attachCellHandlers(cell, blockIndex, scaleStep, startStep, rowIndex, col);

            rowEl.appendChild(cell);
          }
          gridEl.appendChild(rowEl);
        });
      }

      // Read-only mirror of renderSourceGrid for the transformed row-group:
      // plain <div> cells (no handlers, no tabindex), so there is no code
      // path by which interacting with this group could reach setComposition.
      // Reuses the same occupied/note-start/note-end/bar-start/beat-start
      // classes as the source grid, so a run of transformed notes fuses into
      // one continuous block exactly the same way.
      function renderTargetGrid(
        gridEl: HTMLDivElement,
        blockIndex: number,
        rows: number[],
        transformed: Composition,
      ): void {
        rows.forEach((scaleStep) => {
          const rowEl = document.createElement("div");
          rowEl.className = "grid-row";

          const header = document.createElement("div");
          header.className = "row-header";
          header.textContent = pitchLabel(scaleStep, targetSelect.value);
          rowEl.appendChild(header);

          for (let col = 0; col < STEPS_PER_BLOCK; col++) {
            const startStep = stepForBlockColumn(blockIndex, col);
            const occupant = noteAt(transformed, scaleStep, startStep);
            const isNoteStart = occupant?.startStep === startStep;
            const isNoteEnd = occupant !== undefined && occupant.startStep + occupant.lengthSteps - 1 === startStep;

            const cell = document.createElement("div");
            cell.className = "grid-cell readonly";
            if (col % STEPS_PER_BAR === 0) cell.classList.add("bar-start");
            else if (col % STEPS_PER_BEAT === 0) cell.classList.add("beat-start");
            if (occupant) cell.classList.add("occupied");
            if (isNoteStart) cell.classList.add("note-start");
            if (isNoteEnd) cell.classList.add("note-end");

            rowEl.appendChild(cell);
          }
          gridEl.appendChild(rowEl);
        });
      }

      function attachCellHandlers(
        cell: HTMLButtonElement,
        blockIndex: number,
        scaleStep: number,
        startStep: number,
        rowIndex: number,
        col: number,
      ): void {
        cell.addEventListener("pointerdown", (event) => {
          event.preventDefault();
          const occupant = noteAt(composition, scaleStep, startStep);
          if (occupant) {
            setComposition(removeNoteAt(composition, scaleStep, startStep));
            renderAll();
            return; // gesture consumed -- no drag begins on top of a removal
          }

          const rowEl = cell.parentElement as HTMLElement;
          const firstCell = rowEl.querySelector<HTMLButtonElement>('.grid-cell[data-col="0"]')!;
          const rect = firstCell.getBoundingClientRect();
          drag = {
            pointerId: event.pointerId,
            blockIndex,
            scaleStep,
            anchorStep: startStep,
            currentStep: startStep,
            rowEl,
            originLeft: rect.left,
            cellWidth: rect.width,
          };
          cell.setPointerCapture(event.pointerId);
          updateDragPreview();
        });

        cell.addEventListener("pointermove", (event) => {
          if (!drag || event.pointerId !== drag.pointerId) return;
          const localCol = Math.min(
            STEPS_PER_BLOCK - 1,
            Math.max(0, Math.round((event.clientX - drag.originLeft) / drag.cellWidth)),
          );
          const proposedEnd = stepForBlockColumn(drag.blockIndex, localCol);
          const clamped = clampDragEnd(composition, drag.scaleStep, drag.anchorStep, proposedEnd);
          if (clamped !== drag.currentStep) {
            drag.currentStep = clamped;
            updateDragPreview();
          }
        });

        const finishDrag = (event: PointerEvent): void => {
          if (!drag || event.pointerId !== drag.pointerId) return;
          setComposition(commitDrag(composition, drag.scaleStep, drag.anchorStep, drag.currentStep));
          drag = null;
          renderAll();
        };
        cell.addEventListener("pointerup", finishDrag);
        cell.addEventListener("pointercancel", finishDrag);

        cell.addEventListener("keydown", (event) => {
          switch (event.key) {
            case "ArrowRight":
              event.preventDefault();
              if (event.shiftKey) {
                const occupant = noteAt(composition, scaleStep, startStep);
                if (occupant) {
                  setComposition(resizeNote(composition, scaleStep, occupant.startStep, 1));
                  renderAll();
                  focusCell(blockIndex, rowIndex, col);
                }
              } else {
                moveFocus(blockIndex, rowIndex, col + 1);
              }
              break;
            case "ArrowLeft":
              event.preventDefault();
              if (event.shiftKey) {
                const occupant = noteAt(composition, scaleStep, startStep);
                if (occupant) {
                  setComposition(resizeNote(composition, scaleStep, occupant.startStep, -1));
                  renderAll();
                  focusCell(blockIndex, rowIndex, col);
                }
              } else {
                moveFocus(blockIndex, rowIndex, col - 1);
              }
              break;
            case "ArrowUp":
              event.preventDefault();
              moveFocus(blockIndex, rowIndex - 1, col);
              break;
            case "ArrowDown":
              event.preventDefault();
              moveFocus(blockIndex, rowIndex + 1, col);
              break;
            case "Enter":
            case " ":
              event.preventDefault();
              toggleCell(blockIndex, scaleStep, startStep, rowIndex, col);
              break;
            case "Delete":
            case "Backspace":
              event.preventDefault();
              if (noteAt(composition, scaleStep, startStep)) {
                setComposition(removeNoteAt(composition, scaleStep, startStep));
                renderAll();
                focusCell(blockIndex, rowIndex, col);
              }
              break;
          }
        });
      }

      function updateDragPreview(): void {
        if (!drag) return;
        const { rowEl, blockIndex, anchorStep, currentStep } = drag;
        const blockStart = blockIndex * STEPS_PER_BLOCK;
        const lo = Math.min(anchorStep, currentStep) - blockStart;
        const hi = Math.max(anchorStep, currentStep) - blockStart;
        rowEl.querySelectorAll<HTMLButtonElement>(".grid-cell").forEach((el) => {
          const col = Number(el.dataset.col);
          el.classList.toggle("drag-preview", col >= lo && col <= hi);
        });
      }

      function toggleCell(blockIndex: number, scaleStep: number, startStep: number, rowIndex: number, col: number): void {
        const occupant = noteAt(composition, scaleStep, startStep);
        setComposition(
          occupant
            ? removeNoteAt(composition, scaleStep, startStep)
            : commitDrag(composition, scaleStep, startStep, startStep),
        );
        renderAll();
        focusCell(blockIndex, rowIndex, col);
      }

      function moveFocus(blockIndex: number, row: number, col: number): void {
        const rows = currentRows();
        const clampedRow = Math.max(0, Math.min(rows.length - 1, row));
        const clampedCol = Math.max(0, Math.min(STEPS_PER_BLOCK - 1, col));
        focusCell(blockIndex, clampedRow, clampedCol);
      }

      function focusCell(blockIndex: number, row: number, col: number): void {
        focused[blockIndex] = { row, col };
        const container = blockContainers[blockIndex];
        container.querySelectorAll<HTMLButtonElement>(".grid-cell").forEach((el) => {
          const isTarget = Number(el.dataset.row) === row && Number(el.dataset.col) === col;
          el.tabIndex = isTarget ? 0 : -1;
        });
        container.querySelector<HTMLButtonElement>(`.grid-cell[data-row="${row}"][data-col="${col}"]`)?.focus();
      }

      sourceSelect.addEventListener("change", () => {
        setComposition(createEmptyComposition(sourceSelect.value));
        targetSelect.value = sourceSelect.value; // both styles start in sync; only diverge when explicitly changed
        for (const key of Object.keys(focused)) delete focused[Number(key)];
        renderAll();
      });

      clearButton.addEventListener("click", () => {
        setComposition(createEmptyComposition(composition.sourceScale));
        targetSelect.value = composition.sourceScale;
        renderAll();
      });

      // Loads a preset melody straight into the editor: auto-selects Source
      // Style to match, resets Target Style to the same value so the user
      // hears/sees the original first, and replaces (never merges with)
      // whatever was on the grid before -- setComposition assigns a wholly
      // new Composition, and stops playback first, same as every other
      // mutation. Once loaded, the notes are ordinary CompositionNote
      // entries with no special-casing, so they're editable like anything
      // hand-drawn.
      function loadPreset(melody: Melody): void {
        setComposition(sequentialToComposition(melody));
        sourceSelect.value = melody.sourceScale;
        targetSelect.value = melody.sourceScale;
        for (const key of Object.keys(focused)) delete focused[Number(key)];
        renderAll();
      }

      twinkleButton.addEventListener("click", () => loadPreset(TWINKLE_TWINKLE));
      joyButton.addEventListener("click", () => loadPreset(JOY_TO_THE_WORLD));
      moliHuaButton.addEventListener("click", () => loadPreset(MO_LI_HUA));

      // Target style is pure render/UI state, never assigned onto
      // `composition` -- changing it can only ever move where notes are
      // drawn/played, never mutate or clear the source composition.
      targetSelect.addEventListener("change", () => {
        stop();
        renderAll();
      });

      playButton.addEventListener("click", () => {
        playEvents(renderComposition(composition, targetSelect.value, BEAT_SECONDS));
      });
      stopButton.addEventListener("click", stop);

      renderAll();
    </script>

    <style>
      .hint {
        color: #555;
        font-size: 0.9rem;
      }

      .blocks {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .editor-block h2 {
        font-size: 1rem;
        margin: 0 0 0.25rem;
      }

      .grid-scroll {
        overflow-x: auto;
        border: 1px solid #ccc;
        border-radius: 4px;
      }

      .row-group-caption {
        margin: 0.5rem 0.25rem 0.25rem;
        font-size: 0.75rem;
        font-weight: bold;
        color: #444;
      }
    </style>

    <!--
      Every element below is created at runtime via document.createElement in
      the script above, never written in this file's markup. Astro's scoped
      styles only rewrite selectors to match elements present in the compiled
      template -- a data-astro-cid-* attribute it has no way to stamp onto
      elements the browser creates later -- so a scoped <style> here would
      silently match nothing on the actual grid. is:global is required, not
      a style preference.
    -->
    <style is:global>
      .grid-row {
        display: flex;
      }

      .row-header {
        position: sticky;
        left: 0;
        flex: 0 0 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f5f5f5;
        border-right: 1px solid #999;
        font-size: 0.75rem;
        padding: 0 0.25rem;
      }

      .grid-cell {
        flex: 0 0 1.75rem;
        height: 1.75rem;
        min-width: 1.75rem;
        min-height: 1.75rem;
        border: none;
        border-right: 1px solid #e0e0e0;
        border-bottom: 1px solid #e0e0e0;
        background: #fff;
        padding: 0;
        cursor: pointer;
      }

      /* bar-start/beat-start mark the FIRST cell of a new bar/beat, so the
         divider must sit on that cell's LEFT edge -- immediately before its
         startStep -- not its right edge, which would draw the line one
         sixteenth late and make the whole timeline look shifted by one step. */
      .grid-cell.beat-start {
        border-left: 1px solid #b0b0b0;
      }

      .grid-cell.bar-start {
        border-left: 2px solid #555;
      }

      /* A run of occupied cells belonging to one note must read as a single
         unbroken rectangle, not a row of separately-bordered cells -- the
         internal border-right/bottom is overridden to match the fill so
         adjacent occupied cells fuse into one block; only the note's outer
         edges (note-start/note-end) get a border and rounded corner. */
      .grid-cell.occupied {
        background: #0b5fff;
        border-right-color: #0b5fff;
        border-bottom-color: #0b5fff;
      }

      .grid-cell.note-start {
        border-left: 2px solid #063a9e;
        border-top-left-radius: 4px;
        border-bottom-left-radius: 4px;
      }

      .grid-cell.note-end {
        border-right: 2px solid #063a9e;
        border-top-right-radius: 4px;
        border-bottom-right-radius: 4px;
      }

      .grid-cell.drag-preview {
        background: #9dc0ff;
      }

      .grid-cell:focus-visible {
        outline: 2px solid #ff8c00;
        outline-offset: -2px;
      }

      /* Source-group notes, shown outlined-only once a differing target
         style is selected -- the originally-entered notes stay visible but
         visually subordinate to the transformed group's solid fill below. */
      .grid-cell.subdued.occupied {
        background: transparent;
        border-top: 1px solid #0b5fff;
        border-right-color: #0b5fff;
        border-bottom-color: #0b5fff;
      }

      .grid-cell.readonly {
        cursor: default;
      }
    </style>
  </body>
</html>
